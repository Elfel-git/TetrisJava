        img = pygame.image.load(path).convert_alpha()
        return pygame.transform.scale(img, (target_w, target_h))
    except Exception as e:
        print(f"⚠️ Lỗi nạp hoặc co giãn ảnh ({path}): {e}", flush=True)
        return None

