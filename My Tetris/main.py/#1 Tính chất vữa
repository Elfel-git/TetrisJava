def handle_pause_input(event, current_state):
    if event.type == pygame.KEYDOWN:
        if event.key == pygame.K_RETURN:  
            if current_state == "PLAYING":
                return "PAUSED"
            elif current_state == "PAUSED":
                return "PLAYING"
    return current_state

def init_background_music(path, volume):
    print(f"🔍 Đang thử nạp nhạc từ: {path}", flush=True)  # Debug
    print(f"🔍 File tồn tại: {os.path.exists(path)}", flush=True)  # Debug
    try:
        pygame.mixer.music.load(path)
        pygame.mixer.music.set_volume(volume)
        pygame.mixer.music.play(-1)  
        print(f"🎵 Đã bật nhạc nền: {path}", flush=True)
    except Exception as e:
        print(f"⚠️ Không thể nạp nhạc nền ({path}): {e}", flush=True)

def stop_background_music():
    if pygame.mixer.music.get_busy():
        pygame.mixer.music.stop()
        print("🛑 Đã dừng nhạc nền do trò chơi kết thúc.", flush=True)

# =====================================================================
#  11. MAIN LOOP (VÒNG LẶP CHÍNH CỦA HỆ THỐNG GAME)
# =====================================================================
def main():
    init_board()

    score      = 0
    lines_done = 0
    level      = 1
    fall_time  = 0
    fall_speed = 500
    high_score = 0  

    game_state      = "MAIN_MENU" 
    prev_game_state = "MAIN_MENU" 
    sound_on        = True      
    volume          = MUSIC_VOLUME   
    dragging_volume = False     

    # [BỔ SUNG]: Biến ghi nhận thời điểm bắt đầu nhấn nút chơi để tính giây
    game_start_time = 0 

    is_brick      = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]
    current_block = Block(is_brick)

    is_brick_next = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]
    next_block    = Block(is_brick_next)

    running = True
    while running:
        current_time = pygame.time.get_ticks()

        if game_state == "PLAYING":
            handle_mortar_flow()
            check_glue_reaction()

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            
            game_state = handle_pause_input(event, game_state)
                
            if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                mx, my = event.pos
                
                if game_state == "MAIN_MENU":
                    if get_button_rect(MENU_START_X, MENU_START_Y, MENU_BTN_W, MENU_BTN_H).collidepoint(mx, my):
                        init_board()
                        score, lines_done, level, fall_speed = 0, 0, 1, 500
                        current_block = Block(random.choices([True, True, True, False], weights=[1,1,1,0.33])[0])
                        next_block = Block(random.choices([True, True, True, False], weights=[1,1,1,0.33])[0])
                        init_background_music(MUSIC_PATH, volume if sound_on else 0)
                        
                        # [CẬP NHẬT]: Ghi lại mốc thời gian bắt đầu chơi (mili-giây)
                        game_start_time = pygame.time.get_ticks()
                        game_state = "PLAYING"
                        
                    elif get_button_rect(MENU_LOAD_X, MENU_LOAD_Y, MENU_BTN_W, MENU_BTN_H).collidepoint(mx, my):
                        # [SỬA ĐỔI]: Kích hoạt chuyển trạng thái sang mở bảng LOAD lịch sử
                        prev_game_state = "MAIN_MENU"
                        game_state = "LOAD_MENU"
                        
                    elif get_button_rect(MENU_OPTIONS_X, MENU_OPTIONS_Y, MENU_BTN_W, MENU_BTN_H).collidepoint(mx, my):
                        prev_game_state = "MAIN_MENU" 
                        game_state = "SETTINGS"
                    elif get_button_rect(MENU_EXIT_X, MENU_EXIT_Y, MENU_BTN_W, MENU_BTN_H).collidepoint(mx, my):
                        running = False
              
                elif game_state == "PLAYING":
                    if get_button_rect(SETTING_BTN_X, SETTING_BTN_Y, BTN_SIZE, BTN_SIZE).collidepoint(mx, my):
                        prev_game_state = "PLAYING" 
                        game_state = "SETTINGS"
                        
                elif game_state == "SETTINGS":
                    sound_rect, exit_rect, vol_rect = draw_setting_popup(sound_on, volume)
                    if sound_rect.collidepoint(mx, my):
                        sound_on = not sound_on
                        if sound_on:
                            pygame.mixer.music.set_volume(volume)
                        else:
                            pygame.mixer.music.set_volume(0)
                    elif vol_rect.collidepoint(mx, my):
                        dragging_volume = True   
                    elif exit_rect.collidepoint(mx, my):
                        stop_background_music()
                        game_state = "MAIN_MENU"
                        
                # [BỔ SUNG]: Bắt sự kiện Click chuột khi đang ở màn hình LOAD lịch sử
                elif game_state == "LOAD_MENU":
                    close_btn_rect = draw_load_popup()
                    if close_btn_rect.collidepoint(mx, my):
                        game_state = prev_game_state  # Quay lại trạng thái trước đó
                        
                elif game_state == "GAMEOVER":
                    play_rect, back_rect = draw_lose_popup(score, high_score)
                    if play_rect.collidepoint(mx, my):
                        init_board()
                        score, lines_done, level, fall_speed = 0, 0, 1, 500
                        is_brick = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]
                        current_block = Block(is_brick)
                        init_background_music(MUSIC_PATH, volume if sound_on else 0)  
                        game_start_time = pygame.time.get_ticks() # Reset mốc thời gian trận mới
                        game_state = "PLAYING"
                    elif back_rect.collidepoint(mx, my):
                        game_state = "MAIN_MENU"

            elif event.type == pygame.MOUSEBUTTONUP and event.button == 1:
                dragging_volume = False

            elif event.type == pygame.MOUSEMOTION:
                if dragging_volume and game_state == "SETTINGS":
                    bar_x = (SCREEN_WIDTH - 320) // 2 + 40   
                    bar_w = 240
                    mx_now = event.pos[0]
                    volume = max(0.0, min(1.0, (mx_now - bar_x) / bar_w))
                    if sound_on:
                        pygame.mixer.music.set_volume(volume)   

            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_q:
                    running = False
                
                # [BỔ SUNG]: Đóng bảng LOAD khi người chơi nhấn nút ESCAPE
                if game_state == "LOAD_MENU" and event.key == pygame.K_ESCAPE:
                    game_state = prev_game_state
                
                elif game_state == "SETTINGS" and event.key == pygame.K_ESCAPE:
                    game_state = prev_game_state
                
                elif game_state == "PLAYING":
                    if event.key in (pygame.K_LEFT, pygame.K_a) and can_move(current_block, -1, 0):
                        current_block.x -= 1
                    elif event.key in (pygame.K_RIGHT, pygame.K_d) and can_move(current_block, 1, 0):
                        current_block.x += 1
                    elif event.key in (pygame.K_UP, pygame.K_w):
                        current_block.rotate()
                        if not can_move(current_block, 0, 0):
                            for _ in range(3):
                                current_block.rotate()
                    elif event.key in (pygame.K_DOWN, pygame.K_s):
                        fall_speed = 50

        if game_state == "PLAYING":
            if current_time - fall_time > fall_speed:
                if can_move(current_block, 0, 1):
                    current_block.y += 1
                else:
                    place_block(current_block)
                    removed     = remove_lines()
                    lines_done += removed
                    score      += removed * 100 * level
                    level       = lines_done // 10 + 1   
                    fall_speed  = max(100, 500 - (level - 1) * 40) 

                    current_block = next_block
                    is_brick_next = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]
                    next_block    = Block(is_brick_next)
                    fall_speed    = max(100, 500 - (level - 1) * 40)

                    if not can_move(current_block, 0, 0):
                        if score > high_score:
                            high_score = score
                        stop_background_music()   
                        
                        # [CẬP NHẬT]: Khi Game Over, tự động tính tổng thời gian chơi bằng GIÂY và lưu lịch sử
                        duration_seconds = (pygame.time.get_ticks() - game_start_time) // 1000
                        current_date_str = datetime.now().strftime("%d/%m/%Y")
                        
                        # Chèn trận đấu mới lên trên cùng danh sách lịch sử
                        history_data.insert(0, {
                            "score": score,
                            "duration": duration_seconds,
                            "date": current_date_str
                        })
                        
                        game_state = "GAMEOVER"

                fall_time = current_time

        # =====================================================================
        #  HỆ THỐNG QUẢN LÝ VẼ ĐỒ HỌA THEO TRẠNG THÁI (RENDER LAYERS)
        # =====================================================================
        if game_state == "MAIN_MENU":
            draw_main_menu()
            
        elif game_state == "LOAD_MENU" and prev_game_state == "MAIN_MENU":
            # Nếu bấm LOAD từ màn hình chính: Vẽ màn hình chính làm nền rồi phủ Popup Load lên
            draw_main_menu()
            draw_load_popup()
            
        else:
            # Nếu không phải Menu, tiến hành vẽ Đồ họa bàn cờ đang chơi bình thường phía dưới cùng
            draw_background_screen()   
            draw_board()       
            draw_block(current_block)  
            draw_left_panel(score, level)   
            draw_right_panel(next_block)                

            if game_state == "PAUSED":
                draw_pause_overlay()
            elif game_state == "SETTINGS":
                draw_setting_popup(sound_on, volume)
            elif game_state == "GAMEOVER":
                draw_lose_popup(score, high_score)
            elif game_state == "LOAD_MENU":
                # Đề phòng trường hợp bạn muốn mở lịch sử khi game đang tạm dừng (nếu có bổ sung nút sau này)
                draw_load_popup()

        pygame.display.flip()
        clock.tick(FPS)

    stop_background_music()
    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()