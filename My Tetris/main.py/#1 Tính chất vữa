def draw_widget_base(img, x, y, w, h):
    """Draw widget with image or fallback to colored rectangle. Returns (actual_width, actual_height)"""
    if img is not None:
        screen.blit(img, (x, y))
        return (img.get_width(), img.get_height())
    else:
        widget_surf = pygame.Surface((w, h), pygame.SRCALPHA)
        widget_surf.fill((*WIDGET_BG_COLOR, WIDGET_ALPHA))
        pygame.draw.rect(widget_surf, WIDGET_BORDER, (0, 0, w, h), 2)
        screen.blit(widget_surf, (x, y))
        return (w, h)

def _cell_rect(col, row):
    return pygame.Rect(MAP_ORIGIN_X + col * CELL_SIZE, MAP_ORIGIN_Y + row * CELL_SIZE, CELL_SIZE, CELL_SIZE)

def draw_background_screen():
    if bg_image:
        screen.blit(bg_image, (0, 0))
    else:
        screen.fill(MAP_EMPTY)

    map_fill = pygame.Surface((MAP_W, MAP_H), pygame.SRCALPHA)
    map_fill.fill((*MAP_FILL_COLOR, MAP_FILL_ALPHA))
    screen.blit(map_fill, (MAP_ORIGIN_X, MAP_ORIGIN_Y))

    for col in range(W + 1):
        x = MAP_ORIGIN_X + col * CELL_SIZE
        pygame.draw.line(screen, GRID_COLOR, (x, MAP_ORIGIN_Y), (x, MAP_ORIGIN_Y + MAP_H), GRID_THICKNESS)
    for row in range(H + 1):
        y = MAP_ORIGIN_Y + row * CELL_SIZE
        pygame.draw.line(screen, GRID_COLOR, (MAP_ORIGIN_X, y), (MAP_ORIGIN_X + MAP_W, y), GRID_THICKNESS)

    x0, y0 = MAP_ORIGIN_X, MAP_ORIGIN_Y
    x1, y1 = MAP_ORIGIN_X + MAP_W, MAP_ORIGIN_Y + MAP_H
    pygame.draw.line(screen, WALL_COLOR, (x0, y0), (x1, y0), WALL_THICKNESS)  
    pygame.draw.line(screen, WALL_COLOR, (x0, y1), (x1, y1), WALL_THICKNESS)  
    pygame.draw.line(screen, WALL_COLOR, (x0, y0), (x0, y1), WALL_THICKNESS)  
    pygame.draw.line(screen, WALL_COLOR, (x1, y0), (x1, y1), WALL_THICKNESS) 

def draw_board():
    for i in range(H):
        for j in range(W):
            cell = board[i][j]
            rect = _cell_rect(j, i)
            if cell in textures:
                screen.blit(textures[cell], rect)

def draw_block(block):
    for i, row in enumerate(block.shape):
        for j, char in enumerate(row):
            if char != ' ':
                rect      = _cell_rect(block.x + j, block.y + i)
                cell_type = block.brick_type if block.is_brick else 'M'
                if cell_type in textures:
                    screen.blit(textures[cell_type], rect)
                else:
                    pygame.draw.rect(screen, (200, 50, 50), rect)
                pygame.draw.rect(screen, WHITE, rect, 1) 

