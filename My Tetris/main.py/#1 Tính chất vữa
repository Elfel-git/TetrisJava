                if char != ' ':
                    r = pygame.Rect(off_x + j * preview_cell, off_y + i * preview_cell, preview_cell - 2, preview_cell - 2)
                    if cell_type in textures:
                        t = pygame.transform.scale(textures[cell_type], (preview_cell - 2, preview_cell - 2))
